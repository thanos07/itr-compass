# Optional free Neon database for client-encrypted workspace recovery
DATABASE_URL=

# Groq: required only for AI extraction and the four agents
GROQ_API_KEY=
# Low-token default suitable for the free tier. Confirm availability in Groq Console.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-20b
AI_REQUESTS_PER_MINUTE=5
MAX_AI_PAYLOAD_BYTES=200000
AGENT_REQUESTS_PER_MINUTE=6
CLOUD_REQUESTS_PER_MINUTE=12

MAX_CLOUD_PAYLOAD_BYTES=1500000

# Optional safe rollout: set true to emit CSP in report-only mode while testing.
# Keep false/undefined for enforced protection in production.
CSP_REPORT_ONLY=false
